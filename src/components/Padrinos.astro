<!-- ═══════════════════════════════════════════════════════════ --><!-- 👔 SECCIÓN: PADRINOS                                        --><!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full pt-20 pb-12 sm:py-20 md:py-24 lg:py-32">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-center">
            <div class="relative w-[280px]" id="card-padrinos">
                <!-- BOTÓN DECORATIVO SUPERIOR -->
                <div
                    class="absolute z-20"
                    style="top: -30px; left: 50%; transform: translateX(-50%);"
                >
                    <div class="w-16 h-16">
                        <img
                            src="/imagenes/boton.png"
                            alt="Decoración"
                            class="w-full h-full object-contain"
                        />
                    </div>
                </div>

                <!-- FLOR — esquina superior izquierda -->
                <img
                    src="/imagenes/floradorno.png"
                    alt=""
                    id="flor-izq-padrinos"
                    class="absolute -top-7 left-0 w-36 pointer-events-none z-[25]"
                />

                <!-- FLOR — esquina inferior derecha -->
                <img
                    src="/imagenes/floradorno.png"
                    alt=""
                    id="flor-der-padrinos"
                    class="absolute -bottom-7 right-0 w-36 pointer-events-none z-[25]"
                />

                <!-- CARD PRINCIPAL -->
                <div
                    class="relative rounded-[40px] shadow-lg overflow-hidden bg-[#4a5f7f]"
                    id="card-principal-padrinos"
                >
                    <!-- IMAGEN DE FONDO -->
                    <img
                        src="/imagenes/azul.png"
                        alt="Fondo padrinos"
                        class="absolute inset-0 w-full h-full object-cover"
                    />
                    <!-- OVERLAY -->
                    <div class="absolute inset-0 bg-black/20"></div>

                    <div class="relative px-6 pt-14 pb-8 z-10">
                        <!-- TÍTULO -->
                        <div class="text-center mb-4">
                            <h2
                                class="font-great-vibes text-4xl leading-tight"
                                id="titulo-padrinos"
                            >
                                Nuestros Padrinos
                            </h2>
                        </div>

                        <!-- PADRINOS RELIGIOSOS -->
                        <div class="text-center mb-3" id="seccion-religiosos">
                            <h3
                                class="font-crimson text-lg uppercase tracking-wider font-semibold mb-1 subtitulo-padrinos"
                            >
                                Padrinos de Religión
                            </h3>
                            <p
                                class="font-crimson text-xl leading-snug nombres-padrinos"
                            >
                                Mario Bartolomé<br />
                                Eduarda Salvatierra
                            </p>
                        </div>

                        <!-- SEPARADOR -->
                        <div class="ornamento-padrinos my-2">
                            <span class="orn-linea-p"></span>
                            <span class="orn-rombo-p">✦</span>
                            <span class="orn-linea-p"></span>
                        </div>

                        <!-- PADRINOS CIVILES -->
                        <div class="text-center mt-3" id="seccion-civiles">
                            <h3
                                class="font-crimson text-lg uppercase tracking-wider font-semibold mb-1 subtitulo-padrinos"
                            >
                                Padrinos de Civil
                            </h3>
                            <p
                                class="font-crimson text-xl leading-snug nombres-padrinos"
                            >
                                Leismis Alberto Araujo<br />
                                Judith Vaca Orihuela
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            const tl = gsap.timeline({
                scrollTrigger: {
                    trigger: "#card-padrinos",
                    start: "top 80%",
                    toggleActions: "play none none reset",
                },
            });

            tl.fromTo(
                "#card-principal-padrinos",
                { opacity: 0, y: 50, scale: 0.95 },
                { opacity: 1, y: 0, scale: 1, duration: 1, ease: "power3.out" },
                0,
            )
                .fromTo(
                    "#titulo-padrinos",
                    { opacity: 0, y: -20 },
                    { opacity: 1, y: 0, duration: 1, ease: "power2.out" },
                    0,
                )
                .fromTo(
                    "#seccion-religiosos",
                    { opacity: 0, x: -25 },
                    { opacity: 1, x: 0, duration: 0.9, ease: "power2.out" },
                    0.15,
                )
                .fromTo(
                    "#seccion-civiles",
                    { opacity: 0, x: 25 },
                    { opacity: 1, x: 0, duration: 0.9, ease: "power2.out" },
                    0.25,
                );

            const sc = { trigger: "#card-padrinos", start: "top 80%", toggleActions: "play none none reset" };
            gsap.fromTo("#flor-izq-padrinos",
                { opacity: 0, xPercent: -60 },
                { opacity: 1, xPercent: -30, duration: 1.4, ease: "power2.out", delay: 0.4, scrollTrigger: sc }
            );
            gsap.fromTo("#flor-der-padrinos",
                { opacity: 0, xPercent: 60, rotation: 180 },
                { opacity: 1, xPercent: 30, rotation: 180, duration: 1.4, ease: "power2.out", delay: 0.6, scrollTrigger: sc }
            );
        });
    }
</script>

<style>
    #titulo-padrinos {
        color: white;
    }
    .subtitulo-padrinos {
        color: white;
    }
    .nombres-padrinos {
        color: white;
    }

    .ornamento-padrinos {
        display: flex;
        align-items: center;
        gap: 6px;
        max-width: 120px;
        margin-left: auto;
        margin-right: auto;
    }
    .orn-linea-p {
        flex: 1;
        height: 1px;
        background: linear-gradient(
            to right,
            transparent,
            rgba(255, 255, 255, 0.6),
            transparent
        );
    }
    .orn-rombo-p {
        font-size: 9px;
        color: white;
        opacity: 0.85;
    }

    #card-principal-padrinos {
        transition: all 0.4s ease;
        transform-style: preserve-3d;
    }
    #flor-izq-padrinos,
    #flor-der-padrinos {
        opacity: 0;
    }
</style>
