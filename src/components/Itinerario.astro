<!-- ═══════════════════════════════════════════════════════════ --><!-- 📅 SECCIÓN: ITINERARIO                                      --><!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full py-16 sm:py-20 md:py-24 lg:py-32">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-center">
            <div class="relative w-[280px]" id="card-itinerario">
                <!-- BOTÓN DECORATIVO SUPERIOR -->
                <div
                    class="absolute z-20"
                    style="top: -30px; left: 50%; transform: translateX(-50%);"
                >
                    <div class="w-16 h-16" id="boton-decorativo-itinerario">
                        <img
                            src="/imagenes/boton.png"
                            alt="Decoración"
                            class="w-full h-full object-contain"
                        />
                    </div>
                </div>

                <!-- FLOR — esquina superior izquierda -->
                <img
                    src="/imagenes/floradorno.png"
                    alt=""
                    id="flor-izq-itinerario"
                    class="absolute -top-7 left-0 w-36 pointer-events-none z-[25]"
                />

                <!-- FLOR — esquina inferior derecha -->
                <img
                    src="/imagenes/floradorno.png"
                    alt=""
                    id="flor-der-itinerario"
                    class="absolute -bottom-7 right-0 w-36 pointer-events-none z-[25]"
                />

                <!-- CARD PRINCIPAL -->
                <div
                    class="relative rounded-[40px] shadow-xl overflow-hidden bg-[#f5f5f5]"
                    id="card-principal-itinerario"
                >
                    <img
                        src="/imagenes/fondoplomo.png"
                        alt="Fondo itinerario"
                        class="absolute inset-0 w-full h-full object-cover"
                    />
                    <div class="absolute inset-0 bg-white/40"></div>
                    <div
                        class="absolute top-0 left-0 right-0 h-24 bg-gradient-to-b from-white/20 to-transparent"
                    >
                    </div>

                    <div class="relative px-6 pt-14 pb-10 z-10">
                        <!-- TÍTULO -->
                        <div class="text-center mb-2">
                            <h2
                                class="font-great-vibes text-4xl leading-tight"
                                id="titulo-itinerario"
                            >
                                Itinerario
                            </h2>
                        </div>

                        <!-- SEPARADOR -->
                        <div class="ornamento-itinerario mb-6">
                            <span class="orn-linea-it"></span>
                            <span class="orn-rombo-it">✦</span>
                            <span class="orn-linea-it"></span>
                        </div>

                        <!-- EVENTO 1 -->
                        <div class="flex items-start gap-4 mb-5" id="evento-1">
                            <div class="w-12 flex-shrink-0 mt-1">
                                <img
                                    src="/imagenes/iglesia.png"
                                    alt="Ceremonia Religiosa"
                                    class="w-full h-auto object-contain icono-itinerario"
                                />
                            </div>
                            <div class="flex-1 text-center">
                                <h3
                                    class="font-great-vibes text-[1.75rem] leading-none mb-1 titulo-evento"
                                >
                                    Ceremonia Religiosa
                                </h3>
                                <p
                                    class="font-crimson text-lg font-semibold hora-evento"
                                >
                                    17:30 hrs.
                                </p>
                            </div>
                        </div>

                        <!-- EVENTO 2 -->
                        <div class="flex items-start gap-4 mb-5" id="evento-2">
                            <div class="w-12 flex-shrink-0 mt-1">
                                <img
                                    src="/imagenes/recepcion.png"
                                    alt="Recepción Social"
                                    class="w-full h-auto object-contain icono-itinerario"
                                />
                            </div>
                            <div class="flex-1 text-center">
                                <h3
                                    class="font-great-vibes text-[1.75rem] leading-none mb-1 titulo-evento"
                                >
                                    Recepción Social
                                </h3>
                                <p
                                    class="font-crimson text-lg font-semibold hora-evento"
                                >
                                    20:00 hrs.
                                </p>
                            </div>
                        </div>

                        <!-- EVENTO 3 -->
                        <div class="flex items-start gap-4 mb-5" id="evento-3">
                            <div class="w-12 flex-shrink-0 mt-1">
                                <img
                                    src="/imagenes/baile.png"
                                    alt="Vals y Brindis"
                                    class="w-full h-auto object-contain icono-itinerario"
                                />
                            </div>
                            <div class="flex-1 text-center">
                                <h3
                                    class="font-great-vibes text-[1.75rem] leading-none mb-1 titulo-evento"
                                >
                                    Vals de los Novios
                                </h3>
                                <p
                                    class="font-crimson text-lg font-semibold hora-evento"
                                >
                                    20:30 hrs.
                                </p>
                            </div>
                        </div>

                        <!-- EVENTO 4 -->
                        <div class="flex items-start gap-4 mb-5" id="evento-4">
                            <div class="w-12 flex-shrink-0 mt-1">
                                <img
                                    src="/imagenes/cena.png"
                                    alt="Cena"
                                    class="w-full h-auto object-contain icono-itinerario"
                                />
                            </div>
                            <div class="flex-1 text-center">
                                <h3
                                    class="font-great-vibes text-[1.75rem] leading-none mb-1 titulo-evento"
                                >
                                    Deliciosa Cena
                                </h3>
                                <p
                                    class="font-crimson text-lg font-semibold hora-evento"
                                >
                                    21:30 hrs.
                                </p>
                            </div>
                        </div>

                        <!-- EVENTO 5 -->
                        <div class="flex items-start gap-4 mb-5" id="evento-5">
                            <div class="w-12 flex-shrink-0 mt-1">
                                <img
                                    src="/imagenes/musica.png"
                                    alt="Fiesta y Baile"
                                    class="w-full h-auto object-contain icono-itinerario"
                                />
                            </div>
                            <div class="flex-1 text-center">
                                <h3
                                    class="font-great-vibes text-[1.75rem] leading-none mb-1 titulo-evento"
                                >
                                    Fiesta
                                </h3>
                                <p
                                    class="font-crimson text-lg font-semibold hora-evento"
                                >
                                    22:00 hrs.
                                </p>
                            </div>
                        </div>

                        <!-- EVENTO 6 -->
                        <div class="flex items-start gap-4" id="evento-6">
                            <div class="w-12 flex-shrink-0 mt-1">
                                <img
                                    src="/imagenes/torta.png"
                                    alt="Despedida"
                                    class="w-full h-auto object-contain icono-itinerario"
                                />
                            </div>
                            <div class="flex-1 text-center">
                                <h3
                                    class="font-great-vibes text-[1.75rem] leading-none mb-1 titulo-evento"
                                >
                                    Corte de Torta
                                </h3>
                                <p
                                    class="font-crimson text-lg font-semibold hora-evento"
                                >
                                    01:00 hrs.
                                </p>
                            </div>
                        </div>

                        <!-- CIERRE -->
                        <div class="text-center mt-4">
                            <p
                                class="font-great-vibes text-[1.5rem] titulo-evento"
                            >
                                Felices para siempre
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    #titulo-itinerario {
        color: #c4a05a;
    }
    .titulo-evento {
        color: #c4a05a;
    }
    .hora-evento {
        color: #4a6741;
    }

    .ornamento-itinerario {
        display: flex;
        align-items: center;
        gap: 6px;
        max-width: 120px;
        margin-left: auto;
        margin-right: auto;
    }
    .orn-linea-it {
        flex: 1;
        height: 1px;
        background: linear-gradient(
            to right,
            transparent,
            rgba(196, 160, 90, 0.7),
            transparent
        );
    }
    .orn-rombo-it {
        font-size: 9px;
        color: #c4a05a;
        opacity: 0.85;
    }

    .icono-itinerario {
        filter: brightness(0) saturate(100%) invert(35%) sepia(25%)
            saturate(500%) hue-rotate(85deg) brightness(90%) contrast(90%);
    }
    #flor-izq-itinerario,
    #flor-der-itinerario {
        opacity: 0;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            gsap.fromTo(
                "#boton-decorativo-itinerario",
                { opacity: 0, scale: 0, rotation: -180 },
                {
                    opacity: 1,
                    scale: 1,
                    rotation: 0,
                    duration: 1,
                    ease: "back.out(1.7)",
                    scrollTrigger: {
                        trigger: "#card-itinerario",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.fromTo(
                "#card-principal-itinerario",
                { opacity: 0, y: 50, scale: 0.95 },
                {
                    opacity: 1,
                    y: 0,
                    scale: 1,
                    duration: 1,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: "#card-itinerario",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.fromTo(
                "#titulo-itinerario",
                { opacity: 0, y: -20 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: "#card-itinerario",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            [
                "#evento-1",
                "#evento-2",
                "#evento-3",
                "#evento-4",
                "#evento-5",
                "#evento-6",
            ].forEach((evento, index) => {
                gsap.fromTo(
                    evento,
                    { opacity: 0, x: -30 },
                    {
                        opacity: 1,
                        x: 0,
                        duration: 0.6,
                        ease: "power2.out",
                        delay: index * 0.1,
                        scrollTrigger: {
                            trigger: "#card-itinerario",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );
            });

            const sc = {
                trigger: "#card-itinerario",
                start: "top 80%",
                toggleActions: "play none none reset",
            };
            gsap.fromTo(
                "#flor-izq-itinerario",
                { opacity: 0, xPercent: -60 },
                {
                    opacity: 1,
                    xPercent: -30,
                    duration: 1.4,
                    ease: "power2.out",
                    delay: 0.4,
                    scrollTrigger: sc,
                },
            );
            gsap.fromTo(
                "#flor-der-itinerario",
                { opacity: 0, xPercent: 60, rotation: 180 },
                {
                    opacity: 1,
                    xPercent: 30,
                    rotation: 180,
                    duration: 1.4,
                    ease: "power2.out",
                    delay: 0.6,
                    scrollTrigger: sc,
                },
            );
        });
    }
</script>
