<!-- ═══════════════════════════════════════════════════════════ --><!-- 💬 SECCIÓN: CONFIRMA TU ASISTENCIA                         --><!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full py-16 sm:py-20 md:py-24 lg:py-32">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-center">
            <div class="relative w-[300px]" id="card-confirmar">
                <!-- BOTÓN DECORATIVO SUPERIOR -->
                <div
                    class="absolute z-20"
                    style="top: -30px; left: 50%; transform: translateX(-50%);"
                >
                    <div
                        class="w-16 h-16 sm:w-20 sm:h-20"
                        id="boton-decorativo-confirmar"
                    >
                        <img
                            src="/imagenes/boton.png"
                            alt="Decoración"
                            class="w-full h-full object-contain"
                        />
                    </div>
                </div>

                <!-- FLOR — esquina superior izquierda -->
                <img
                    src="/imagenes/floradorno.png"
                    alt=""
                    id="flor-izq-confirmar"
                    class="absolute -top-7 left-0 w-36 pointer-events-none z-[25]"
                />

                <!-- FLOR — esquina inferior derecha -->
                <img
                    src="/imagenes/floradorno.png"
                    alt=""
                    id="flor-der-confirmar"
                    class="absolute -bottom-7 right-0 w-36 pointer-events-none z-[25]"
                />

                <!-- CARD PRINCIPAL -->
                <div
                    class="relative rounded-[40px] shadow-xl overflow-hidden bg-[#f5f5f5]"
                    id="card-principal-confirmar"
                >
                    <img
                        src="/imagenes/fondoplomo.png"
                        alt="Fondo confirmar"
                        class="absolute inset-0 w-full h-full object-cover"
                    />
                    <div class="absolute inset-0 bg-white/40"></div>
                    <div
                        class="absolute top-0 left-0 right-0 h-24 bg-gradient-to-b from-white/20 to-transparent"
                    ></div>

                    <div
                        class="relative px-6 pt-14 pb-12 sm:px-8 z-10 flex flex-col items-center justify-center"
                    >
                        <!-- TÍTULO -->
                        <div class="text-center mb-6" id="titulo-confirmar">
                            <h2
                                class="font-great-vibes text-4xl leading-tight confirmar-titulo"
                            >
                                Confirma tu Asistencia
                            </h2>
                        </div>

                        <!-- TEXTO -->
                        <div class="text-center mb-8" id="texto-confirmar">
                            <p
                                class="font-crimson text-xl sm:text-lg leading-relaxed confirmar-texto"
                            >
                                Será de mucha alegría<br />
                                para nosotros contar<br />
                                con tu compañía en este<br />
                                día tan importante.
                            </p>
                        </div>

                        <!-- BOTÓN -->
                        <div
                            class="flex justify-center"
                            id="boton-formulario-confirmar"
                        >
                            <a
                                href="https://wa.me/59170020023?text=Me%20complace%20confirmar%20mi%20asistencia%20a%20la%20boda%20de%20Gabriela%20y%20Berman.%20Nos%20vemos%20el%20s%C3%A1bado%2013%20de%20junio.%20%C2%A1Estar%C3%A9%20sin%20falta!"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center justify-center gap-2 px-2 py-3 border-2 font-crimson text-base uppercase tracking-wider rounded-full transition-all duration-300 hover:scale-105 whitespace-nowrap confirmar-btn"
                                aria-label="Confirmar asistencia"
                            >
                                <svg
                                    class="w-5 h-5 flex-shrink-0"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                    xmlns="http://www.w3.org/2000/svg"
                                >
                                    <path
                                        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                                    ></path>
                                </svg>
                                <span class="font-semibold"
                                    >Confirmar asistencia</span
                                >
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            gsap.fromTo(
                "#boton-decorativo-confirmar",
                { opacity: 0, scale: 0, rotation: -180 },
                {
                    opacity: 1,
                    scale: 1,
                    rotation: 0,
                    duration: 1,
                    ease: "back.out(1.7)",
                    scrollTrigger: {
                        trigger: "#card-confirmar",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.fromTo(
                "#card-principal-confirmar",
                { opacity: 0, y: 50, scale: 0.95 },
                {
                    opacity: 1,
                    y: 0,
                    scale: 1,
                    duration: 1,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: "#card-confirmar",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.fromTo(
                "#titulo-confirmar",
                { opacity: 0, y: -20 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    delay: 0.3,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: "#card-confirmar",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.fromTo(
                "#texto-confirmar",
                { opacity: 0, y: 20 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    delay: 0.5,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: "#card-confirmar",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.fromTo(
                "#boton-formulario-confirmar",
                { opacity: 0, scale: 0.8, y: 20 },
                {
                    opacity: 1,
                    scale: 1,
                    y: 0,
                    duration: 0.8,
                    delay: 0.7,
                    ease: "back.out(1.5)",
                    scrollTrigger: {
                        trigger: "#card-confirmar",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.to("#boton-decorativo-confirmar", {
                y: -5,
                duration: 2,
                ease: "sine.inOut",
                yoyo: true,
                repeat: -1,
                delay: 1,
            });

            gsap.to("#boton-formulario-confirmar a", {
                y: -3,
                duration: 2,
                ease: "sine.inOut",
                yoyo: true,
                repeat: -1,
                delay: 1,
            });

            const scF = { trigger: "#card-confirmar", start: "top 80%", toggleActions: "play none none reset" };
            gsap.fromTo("#flor-izq-confirmar",
                { opacity: 0, xPercent: -60 },
                { opacity: 1, xPercent: -30, duration: 1.4, ease: "power2.out", delay: 0.4, scrollTrigger: scF }
            );
            gsap.fromTo("#flor-der-confirmar",
                { opacity: 0, xPercent: 60, rotation: 180 },
                { opacity: 1, xPercent: 30, rotation: 180, duration: 1.4, ease: "power2.out", delay: 0.6, scrollTrigger: scF }
            );
        });
    }
</script>

<style>
    .confirmar-titulo {
        color: #c4a05a;
    }
    .confirmar-texto {
        color: #4a6741;
    }
    .confirmar-btn {
        color: #4a6741;
        border-color: #4a6741;
    }
    .confirmar-btn:hover {
        background-color: #4a6741;
        color: white;
        transform: scale(1.05);
        box-shadow: 0 5px 15px rgba(74, 103, 65, 0.3);
    }

    #flor-izq-confirmar,
    #flor-der-confirmar {
        opacity: 0;
    }
    #card-principal-confirmar {
        transition: all 0.4s ease;
    }
    #card-principal-confirmar:hover {
        transform: translateY(-8px);
        box-shadow: 0 25px 50px rgba(74, 103, 65, 0.2);
    }
    #boton-formulario-confirmar a:active {
        outline: none;
        transform: scale(0.95);
    }
</style>
