<!-- ═══════════════════════════════════════════════════════════ --><!-- 👥 SECCIÓN: ACOMPAÑANTES (SIN NIÑOS)                        --><!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full pt-20 pb-10 sm:py-20 md:py-24 lg:py-32">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-center">
            <div class="relative w-[280px]" id="card-acompanantes">
                <!-- BOTÓN DECORATIVO SUPERIOR -->
                <div
                    class="absolute z-20"
                    style="top: -30px; left: 50%; transform: translateX(-50%);"
                >
                    <div class="w-16 h-16" id="boton-decorativo-acompanantes">
                        <img
                            src="/imagenes/boton.png"
                            alt="Decoración"
                            class="w-full h-full object-contain"
                        />
                    </div>
                </div>

                <!-- FLOR — esquina superior izquierda -->
                <img
                    src="/imagenes/floradorno.png"
                    alt=""
                    id="flor-izq-restrict"
                    class="absolute -top-7 left-0 w-36 pointer-events-none z-[25]"
                />

                <!-- FLOR — esquina inferior derecha -->
                <img
                    src="/imagenes/floradorno.png"
                    alt=""
                    id="flor-der-restrict"
                    class="absolute -bottom-7 right-0 w-36 pointer-events-none z-[25]"
                />

                <!-- CARD PRINCIPAL -->
                <div
                    class="relative rounded-[40px] shadow-xl overflow-hidden bg-[#f5f5f5]"
                    id="card-principal-acompanantes"
                >
                    <img
                        src="/imagenes/fondoplomo.png"
                        alt="Fondo acompañantes"
                        class="absolute inset-0 w-full h-full object-cover"
                    />
                    <div class="absolute inset-0 bg-white/40"></div>
                    <div
                        class="absolute top-0 left-0 right-0 h-24 bg-gradient-to-b from-white/20 to-transparent"
                    >
                    </div>

                    <div
                        class="relative px-4 pt-14 pb-10 z-10 flex flex-col items-center"
                    >
                        <!-- IMAGEN RESTRICCIÓN -->
                        <div class="mb-4" id="imagen-restriccion">
                            <img
                                src="/imagenes/restriccion.png"
                                alt="Sin niños"
                                class="w-20 h-20 object-contain mx-auto icono-restriccion"
                            />
                        </div>

                        <div class="text-center" id="texto-acompanantes">
                            <p
                                class="font-crimson text-xl leading-relaxed acomp-texto"
                            >
                                Aunque queremos mucho a los más pequeños, en
                                esta ocasión nuestra celebración estará
                                destinada exclusivamente para adultos. <br />
                                Agradecemos su comprensión y cariño.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            gsap.fromTo(
                "#boton-decorativo-acompanantes",
                { opacity: 0, scale: 0, rotation: -180 },
                {
                    opacity: 1,
                    scale: 1,
                    rotation: 0,
                    duration: 1,
                    ease: "back.out(1.7)",
                    scrollTrigger: {
                        trigger: "#card-acompanantes",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.fromTo(
                "#card-principal-acompanantes",
                { opacity: 0, y: 50, scale: 0.95 },
                {
                    opacity: 1,
                    y: 0,
                    scale: 1,
                    duration: 1,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: "#card-acompanantes",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.fromTo(
                "#imagen-restriccion",
                { opacity: 0, scale: 0 },
                {
                    opacity: 1,
                    scale: 1,
                    duration: 0.8,
                    delay: 0.2,
                    ease: "back.out(1.7)",
                    scrollTrigger: {
                        trigger: "#card-acompanantes",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.fromTo(
                "#texto-acompanantes",
                { opacity: 0, y: 20 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    delay: 0.3,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: "#card-acompanantes",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            const scF = {
                trigger: "#card-acompanantes",
                start: "top 80%",
                toggleActions: "play none none reset",
            };
            gsap.fromTo(
                "#flor-izq-restrict",
                { opacity: 0, xPercent: -60 },
                {
                    opacity: 1,
                    xPercent: -30,
                    duration: 1.4,
                    ease: "power2.out",
                    delay: 0.4,
                    scrollTrigger: scF,
                },
            );
            gsap.fromTo(
                "#flor-der-restrict",
                { opacity: 0, xPercent: 60, rotation: 180 },
                {
                    opacity: 1,
                    xPercent: 30,
                    rotation: 180,
                    duration: 1.4,
                    ease: "power2.out",
                    delay: 0.6,
                    scrollTrigger: scF,
                },
            );
        });
    }
</script>

<style>
    .acomp-texto {
        color: #4a6741;
    }
    .acomp-acento {
        color: #c4a05a;
    }
    .icono-restriccion {
        filter: brightness(0) saturate(100%) invert(35%) sepia(25%)
            saturate(500%) hue-rotate(85deg) brightness(90%) contrast(90%);
    }
    #flor-izq-restrict,
    #flor-der-restrict {
        opacity: 0;
    }
</style>
