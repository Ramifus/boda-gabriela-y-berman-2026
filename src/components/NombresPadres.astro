<!-- ═══════════════════════════════════════════════════════════ --><!-- 👨‍👩‍👧‍👦 SECCIÓN: NUESTROS PADRES                                --><!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full pt-20 pb-12 sm:py-20 md:py-24 lg:py-32">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-center">
            <div class="relative w-[280px]" id="card-padres">
                <!-- BOTÓN DECORATIVO SUPERIOR -->
                <div
                    class="absolute z-20"
                    style="top: -30px; left: 50%; transform: translateX(-50%);"
                >
                    <div class="w-16 h-16" id="boton-decorativo">
                        <img
                            src="/imagenes/boton.png"
                            alt="Decoración"
                            class="w-full h-full object-contain"
                        />
                    </div>
                </div>

                <!-- FLOR — esquina superior izquierda -->
                <img
                    src="/imagenes/floradorno.png"
                    alt=""
                    id="flor-izq-padres"
                    class="absolute -top-7 left-0 w-36 pointer-events-none z-[25]"
                />

                <!-- FLOR — esquina inferior derecha -->
                <img
                    src="/imagenes/floradorno.png"
                    alt=""
                    id="flor-der-padres"
                    class="absolute -bottom-7 right-0 w-36 pointer-events-none z-[25]"
                />

                <!-- CARD PRINCIPAL -->
                <div
                    class="relative rounded-lg shadow-xl overflow-hidden bg-[#f5f5f5]"
                    id="card-principal"
                >
                    <img
                        src="/imagenes/fondoplomo.png"
                        alt=""
                        class="absolute inset-0 w-full h-full object-cover"
                    />
                    <div class="absolute inset-0 bg-white/40"></div>
                    <div
                        class="absolute top-0 left-0 right-0 h-24 bg-gradient-to-b from-white/20 to-transparent"
                    ></div>

                    <div class="relative px-6 pt-14 pb-8 z-10">
                        <!-- TÍTULO -->
                        <div class="text-center mb-4">
                            <h2
                                class="font-great-vibes text-4xl leading-tight text-center"
                                id="titulo-padres"
                            >
                                Nuestros Padres
                            </h2>
                        </div>

                        <!-- PADRES DEL NOVIO -->
                        <div class="text-center mb-3" id="seccion-novia">
                            <h3
                                class="font-crimson text-lg uppercase tracking-wider font-semibold mb-1 subtitulo"
                            >
                                Padres del Novio
                            </h3>
                            <p
                                class="font-crimson text-xl leading-snug nombres-azul"
                            >
                                Iver Algarañaz<br />
                                Irma Mejía
                            </p>
                        </div>

                        <!-- SEPARADOR -->
                        <div class="ornamento my-2">
                            <span class="orn-linea"></span>
                            <span class="orn-rombo">✦</span>
                            <span class="orn-linea"></span>
                        </div>

                        <!-- PADRES DE LA NOVIA -->
                        <div class="text-center mt-3" id="seccion-novio">
                            <h3
                                class="font-crimson text-lg uppercase tracking-wider font-semibold mb-1 subtitulo"
                            >
                                Padres de la Novia
                            </h3>
                            <p
                                class="font-crimson text-xl leading-snug nombres-azul"
                            >
                                Javier Mendoza<br />
                                Raquel Rivero
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            const tl = gsap.timeline({
                scrollTrigger: {
                    trigger: "#card-padres",
                    start: "top 80%",
                    toggleActions: "play none none reset",
                },
            });

            tl.fromTo(
                "#boton-decorativo",
                { opacity: 0, scale: 0, rotation: -180 },
                {
                    opacity: 1,
                    scale: 1,
                    rotation: 0,
                    duration: 1,
                    ease: "back.out(1.7)",
                },
                0,
            )
                .fromTo(
                    "#card-principal",
                    { opacity: 0, y: 50, scale: 0.95 },
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 1,
                        ease: "power3.out",
                    },
                    0,
                )
                .fromTo(
                    "#titulo-padres",
                    { opacity: 0, y: -20 },
                    { opacity: 1, y: 0, duration: 1, ease: "power2.out" },
                    0,
                )
                .fromTo(
                    "#seccion-novia",
                    { opacity: 0, x: -25 },
                    { opacity: 1, x: 0, duration: 0.9, ease: "power2.out" },
                    0.15,
                )
                .fromTo(
                    "#seccion-novio",
                    { opacity: 0, x: 25 },
                    { opacity: 1, x: 0, duration: 0.9, ease: "power2.out" },
                    0.25,
                )
                .fromTo(
                    "#seccion-padrinos",
                    { opacity: 0, y: 20 },
                    { opacity: 1, y: 0, duration: 0.9, ease: "power2.out" },
                    0.35,
                );

            const sc = { trigger: "#card-padres", start: "top 80%", toggleActions: "play none none reset" };

            gsap.fromTo("#flor-izq-padres",
                { opacity: 0, xPercent: -60 },
                { opacity: 1, xPercent: -30, duration: 1.4, ease: "power2.out", delay: 0.4, scrollTrigger: sc }
            );
            gsap.fromTo("#flor-der-padres",
                { opacity: 0, xPercent: 60, rotation: 180 },
                { opacity: 1, xPercent: 30, rotation: 180, duration: 1.4, ease: "power2.out", delay: 0.6, scrollTrigger: sc }
            );
        });
    }
</script>

<style>
    #titulo-padres {
        color: #c4a05a;
    }
    .subtitulo {
        color: #c4a05a;
    }
    .nombres-azul {
        color: #4a6741;
    }

    .ornamento {
        display: flex;
        align-items: center;
        gap: 6px;
        max-width: 120px;
        margin-left: auto;
        margin-right: auto;
    }
    .orn-linea {
        flex: 1;
        height: 1px;
        background: linear-gradient(
            to right,
            transparent,
            rgba(196, 160, 90, 0.7),
            transparent
        );
    }
    .orn-rombo {
        font-size: 9px;
        color: #c4a05a;
        opacity: 0.85;
    }

    #card-principal {
        transition: all 0.4s ease;
        transform-style: preserve-3d;
    }

    #flor-izq-padres,
    #flor-der-padres {
        opacity: 0;
    }
</style>
